<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.FaisalAI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">?attr/colAccent</item>
        <item name="colorOnPrimary">?attr/colOnAccent</item>
        <item name="colorAccent">?attr/colAccent</item>
        <item name="colorSecondary">?attr/colAccent</item>
        <item name="colorOnSecondary">?attr/colOnAccent</item>
        <item name="colorPrimaryContainer">?attr/colSurface2</item>
        <item name="colorOnPrimaryContainer">?attr/colFg</item>
        <item name="colorSecondaryContainer">?attr/colSurface2</item>
        <item name="colorOnSecondaryContainer">?attr/colFg</item>
        <item name="android:colorBackground">?attr/colBg</item>
        <item name="colorSurface">?attr/colBg</item>
        <item name="colorSurfaceContainerLow">?attr/colSurface</item>
        <item name="colorSurfaceContainer">?attr/colSurface</item>
        <item name="colorSurfaceContainerHigh">?attr/colSurface</item>
        <item name="colorSurfaceContainerHighest">?attr/colSurface2</item>
        <item name="colorOnSurface">?attr/colFg</item>
        <item name="colorOnBackground">?attr/colFg</item>
        <item name="colorOnSurfaceVariant">?attr/colMuted</item>
        <item name="colorOutline">?attr/colLine</item>
        <item name="colorError">?attr/colDanger</item>
        <item name="android:textColorPrimary">?attr/colFg</item>
        <item name="android:textColorSecondary">?attr/colMuted</item>
        <item name="android:textColorHint">?attr/colMuted</item>
        <item name="android:statusBarColor">?attr/colBg</item>
        <item name="android:navigationBarColor">?attr/colBg</item>
    </style>
    <style name="Theme.FaisalAI.Classic">
        <item name="colBg">@color/bg</item>
        <item name="colSurface">@color/surface</item>
        <item name="colSurface2">@color/surface2</item>
        <item name="colLine">@color/line</item>
        <item name="colFg">@color/fg</item>
        <item name="colMuted">@color/muted</item>
        <item name="colAccent">@color/accent</item>
        <item name="colOnAccent">@color/on_accent</item>
        <item name="colDanger">@color/danger</item>
        <item name="colGlow">#00000000</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
    </style>
    <style name="Theme.FaisalAI.Black">
        <item name="colBg">#000000</item>
        <item name="colSurface">#0E0E0E</item>
        <item name="colSurface2">#1A1A1A</item>
        <item name="colLine">#3A3A3A</item>
        <item name="colFg">#FFFFFF</item>
        <item name="colMuted">#A8A8A8</item>
        <item name="colAccent">#FFFFFF</item>
        <item name="colOnAccent">#000000</item>
        <item name="colDanger">#FF7A7A</item>
        <item name="colGlow">#00000000</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="Theme.FaisalAI.White">
        <item name="colBg">#FFFFFF</item>
        <item name="colSurface">#F6F6F6</item>
        <item name="colSurface2">#ECECEC</item>
        <item name="colLine">#BDBDBD</item>
        <item name="colFg">#000000</item>
        <item name="colMuted">#555555</item>
        <item name="colAccent">#111111</item>
        <item name="colOnAccent">#FFFFFF</item>
        <item name="colDanger">#C22A2A</item>
        <item name="colGlow">#00000000</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.FaisalAI.Neon">
        <item name="colBg">#05010D</item>
        <item name="colSurface">#0D0620</item>
        <item name="colSurface2">#160B33</item>
        <item name="colLine">#00E5FF</item>
        <item name="colFg">#EAFBFF</item>
        <item name="colMuted">#9BB8D0</item>
        <item name="colAccent">#FF2BD6</item>
        <item name="colOnAccent">#14000F</item>
        <item name="colDanger">#FF6B8B</item>
        <item name="colGlow">#5500E5FF</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
