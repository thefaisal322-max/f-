<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colBg">
    <include layout="@layout/bar" />
    <include layout="@layout/scan_tabs" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/scan_hint" android:textColor="?attr/colMuted" android:textSize="14sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:orientation="horizontal">
                <Button android:id="@+id/btnCamera" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/camera" />
                <Button android:id="@+id/btnGallery" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/gallery" />
            </LinearLayout>
            <ImageView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="320dp" android:layout_marginTop="12dp"
                android:scaleType="fitCenter" android:background="@drawable/bg_field" android:padding="4dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/count" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:textColor="?attr/colFg" android:textSize="14sp" />
            <com.google.android.material.tabs.TabLayout android:id="@+id/modes"
                android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:background="@drawable/bg_field"
                app:tabIndicatorColor="?attr/colAccent" app:tabSelectedTextColor="?attr/colFg" app:tabTextColor="?attr/colMuted" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btnRotate" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/rotate" />
                <Button android:id="@+id/btnClear" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/clear_pages" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/scan_save" android:textColor="?attr/colMuted" android:textSize="14sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btnPdf"  android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/f_pdf" />
                <Button android:id="@+id/btnDocx"  android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/f_docx" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btnPng"  android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/f_png" />
                <Button android:id="@+id/btnJpg"  android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/f_jpg" />
            </LinearLayout>
            <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textColor="?attr/colFg" android:textSize="14sp" android:textIsSelectable="true" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
