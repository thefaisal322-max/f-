<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:gravity="center_horizontal"
    android:paddingTop="8dp" android:paddingBottom="12dp"
    android:clickable="true" android:focusable="true">
    <ImageView android:id="@+id/icon" android:layout_width="58dp" android:layout_height="58dp"
        android:background="@drawable/bg_tile" android:padding="17dp" android:importantForAccessibility="no" />
    <TextView android:id="@+id/label" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="center" android:textColor="@color/fg" android:textSize="13sp" />
</LinearLayout>
