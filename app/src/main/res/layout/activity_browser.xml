<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colBg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:padding="6dp">
        <ImageButton android:id="@+id/navBack" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:contentDescription="@android:string/cancel" />
        <ImageButton android:id="@+id/navForward" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_forward" android:contentDescription="@string/t_browser" />
        <EditText android:id="@+id/url" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1"
            android:background="@drawable/bg_field" android:paddingStart="12dp" android:paddingEnd="12dp"
            android:hint="@string/url_hint" android:textColor="?attr/colFg" android:textSize="15sp"
            android:inputType="textUri" android:imeOptions="actionGo" android:maxLines="1" android:selectAllOnFocus="true" android:importantForAutofill="no" />
        <ImageButton android:id="@+id/reload" android:layout_width="44dp" android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_reload" android:contentDescription="@string/t_browser" />
    </LinearLayout>
    <com.google.android.material.tabs.TabLayout android:id="@+id/modes"
        android:layout_width="match_parent" android:layout_height="44dp" android:background="?attr/colBg"
        app:tabMode="scrollable" app:tabIndicatorColor="?attr/colAccent" app:tabSelectedTextColor="?attr/colFg" app:tabTextColor="?attr/colMuted" />
    <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent" android:layout_height="3dp" android:max="100" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/web" android:layout_width="match_parent" android:layout_height="match_parent" />
        <ScrollView android:id="@+id/aiPanel" android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="?attr/colBg" android:visibility="gone">
            <TextView android:id="@+id/aiText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="16dp"
                android:textColor="?attr/colFg" android:textColorLink="?attr/colAccent" android:textSize="16sp"
                android:autoLink="web" android:textIsSelectable="true" />
        </ScrollView>
    </FrameLayout>
</LinearLayout>
