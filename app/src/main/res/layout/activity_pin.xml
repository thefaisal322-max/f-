<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"
    android:background="?attr/colBg" android:padding="32dp">
    <ImageView android:layout_width="96dp" android:layout_height="96dp" android:src="@drawable/ic_launcher_fg" android:importantForAccessibility="no" />
    <TextView android:id="@+id/pinTitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/pin_title" android:textColor="?attr/colFg" android:textSize="20sp" android:textStyle="bold" />
    <EditText android:id="@+id/pinBox" android:layout_width="220dp" android:layout_height="56dp" android:layout_marginTop="20dp" android:background="@drawable/bg_field"
        android:gravity="center" android:inputType="numberPassword" android:maxLength="6" android:textColor="?attr/colFg" android:textSize="24sp"
        android:importantForAutofill="no" />
    <Button android:id="@+id/pinGo" android:layout_width="220dp" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="@string/pin_unlock" />
</LinearLayout>
