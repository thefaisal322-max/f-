<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="?attr/colBg">
    <include layout="@layout/bar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <Button android:id="@+id/pick" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/share_pick" />
            <TextView android:id="@+id/chosen" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/share_none" android:textColor="?attr/colMuted" android:textSize="14sp" />
            <Button android:id="@+id/start" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/share_start" />
            <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/share_info" android:textColor="?attr/colMuted" android:textSize="14sp" android:visibility="gone" />
            <TextView android:id="@+id/address" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:padding="14dp" android:gravity="center" android:background="@drawable/bg_bot" android:textDirection="ltr"
                android:textColor="?attr/colFg" android:textSize="20sp" android:textStyle="bold" android:textIsSelectable="true" android:visibility="gone" />
            <TextView android:id="@+id/qrHint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:text="@string/scan_qr" android:textColor="?attr/colMuted" android:textSize="14sp" android:visibility="gone" />
            <ImageView android:id="@+id/qr" android:layout_width="220dp" android:layout_height="220dp" android:layout_marginTop="8dp"
                android:layout_gravity="center_horizontal" android:visibility="gone" android:importantForAccessibility="no" />
            <TextView android:id="@+id/received" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:textColor="?attr/colFg" android:textSize="14sp" />
            <Button android:id="@+id/other" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/share_other" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
