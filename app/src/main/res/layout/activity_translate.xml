<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bg">
    <include layout="@layout/bar" />
    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="16dp">

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Spinner android:id="@+id/from" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/bg_field" />
                <Spinner android:id="@+id/to" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:layout_marginStart="8dp" android:background="@drawable/bg_field" />
            </LinearLayout>
            <EditText android:id="@+id/input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:minLines="4" android:gravity="top|start" android:background="@drawable/bg_field" android:padding="12dp"
                android:hint="@string/tr_hint" android:textColor="@color/fg" android:textSize="16sp"
                android:inputType="textMultiLine" android:importantForAutofill="no" />
            <Button android:id="@+id/go" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/translate" />

            <TextView android:id="@+id/out" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:minHeight="72dp" android:padding="12dp"
                android:background="@drawable/bg_bot" android:textColor="@color/fg" android:textSize="16sp" android:textIsSelectable="true" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
                <Button android:id="@+id/btnCopy" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/copy" />
                <Button android:id="@+id/btnSave" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="8dp" android:text="@string/save_files" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
